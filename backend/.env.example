# MongoDB — Required for BucketList feature (personal goals, squads, team goals)
# Get a free cluster at https://cloud.mongodb.com → Atlas Free Tier
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Example: mongodb+srv://lifequest:MySecurePass@cluster0.abcde.mongodb.net/lifequest?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster0.xxxxx.mongodb.net/lifequest?retryWrites=true&w=majority
